# ── Database ────────────────────────────────────────────────────────────────
# Neon: use the POOLED connection string (host contains "-pooler").
# Local: postgres://postgres:postgres@localhost:5433/landscape  (podman, see README)
DATABASE_URL=

# ── Auth (Clerk, https://dashboard.clerk.com) ───────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# Optional now: users are also created on first sign-in without the webhook.
CLERK_WEBHOOK_SIGNING_SECRET=

# ── Receipt scanning (Claude) ───────────────────────────────────────────────
# https://console.anthropic.com → API keys. Each scan costs a few cents.
ANTHROPIC_API_KEY=
# Optional override (default claude-opus-5-5).
# RECEIPT_MODEL=claude-opus-5-5

# ── Local development only ──────────────────────────────────────────────────
# AUTH_MODE=dev        → no Clerk, everyone is the "Demo" user. Refused on Vercel production.
# RECEIPT_SCANNER=mock → scans return sample receipts instead of calling Claude.
# AUTH_MODE=dev
# RECEIPT_SCANNER=mock
